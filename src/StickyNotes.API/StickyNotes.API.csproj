<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <SpaRoot>..\WebApp\</SpaRoot>
        <SpaDist>$(SpaRoot)dist\</SpaDist>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Npgsql" Version="10.0.3"/>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3"/>
    </ItemGroup>

    <Target Name="BuildFrontend" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
        <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(SpaRoot)"/>
        <Exec Command="pnpm build" WorkingDirectory="$(SpaRoot)"/>
    </Target>

    <Target Name="CopyFrontend" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
        <ItemGroup>
            <FrontendFiles Include="$(SpaDist)**\*"/>
        </ItemGroup>
        <Copy SourceFiles="@(FrontendFiles)" DestinationFiles="@(FrontendFiles->'$(OutputPath)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
    </Target>
</Project>
